        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "policyId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Policyid",
          "type": "string"
        },
        "postTradeCashRatio": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
