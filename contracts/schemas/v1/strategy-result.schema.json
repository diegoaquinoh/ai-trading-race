          "type": "string"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "inputSnapshotIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Inputsnapshotids",
          "type": "array"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "role": {
          "enum": [
            "macro_researcher",
            "critical_reviewer"
