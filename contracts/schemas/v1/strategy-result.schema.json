          "title": "Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "denied_budget",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "taskId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Taskid",
          "type": "string"
        },
        "usage": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "required": [
        "taskId",
        "role",
        "instruction",
        "inputSnapshotIds",
        "expectedOutputSchema",
        "budgetReserved",
        "status"
      ],
      "title": "SpecialistTask",
      "type": "object"
    },
    "StrategyKind": {
      "enum": [
        "cash_reference",
        "quant_policy",
        "single_agent",
        "specialist_team"
      ],
      "title": "StrategyKind",
      "type": "string"
    },
    "TargetWeight": {
      "additionalProperties": false,
