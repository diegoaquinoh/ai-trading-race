          "type": "boolean"
        },
        "calculationIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Calculationids",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/PolicyCheck"
