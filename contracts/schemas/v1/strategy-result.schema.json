{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "bundleId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Bundleid",
          "type": "string"
        },
        "chunkId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Chunkid",
          "type": "string"
        },
        "citationId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Citationid",
          "type": "string"
        },
        "documentVersionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Documentversionid",
          "type": "string"
        },
        "endOffset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endoffset"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "startOffset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startoffset"
        }
      },
      "required": [
        "citationId",
        "bundleId",
        "chunkId",
        "documentVersionId"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DecisionAction": {
      "enum": [
        "HOLD",
        "REBALANCE",
        "BOOTSTRAP"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "DecisionAttempt": {
      "additionalProperties": false,
      "properties": {
        "agentRole": {
          "title": "Agentrole",
          "type": "string"
        },
        "attemptId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Attemptid",
          "type": "string"
        },
        "attemptNumber": {
          "title": "Attemptnumber",
          "type": "integer"
        },
        "durationMs": {
          "title": "Durationms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "inputTokens": {
          "title": "Inputtokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "outputTokens": {
          "title": "Outputtokens",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "task_assignment",
            "tool_selection",
            "specialist",
            "synthesis",
            "repair",
            "single"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "recordedResponseId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recordedresponseid"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "malformed",
            "provider_error",
            "timeout",
            "denied_budget"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "attemptNumber",
        "agentRole",
        "purpose",
        "provider",
        "model",
        "inputTokens",
        "outputTokens",
        "startedAt",
        "durationMs",
        "status"
      ],
      "title": "DecisionAttempt",
      "type": "object"
    },
    "DecisionOutcome": {
      "enum": [
        "completed_hold",
        "completed_proposal",
        "abstained_insufficient_evidence",
        "review_required",
        "failed_invalid_output",
        "failed_dependency",
        "failed_budget",
        "skipped_stale_data",
        "cancelled"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "DocumentaryClaim": {
      "additionalProperties": false,
      "properties": {
        "citationIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Citationids",
          "type": "array"
        },
        "claimId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Claimid",
          "type": "string"
        },
        "material": {
          "default": true,
          "title": "Material",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "validationNotes": {
          "items": {
            "type": "string"
          },
          "title": "Validationnotes",
          "type": "array"
        },
        "validationStatus": {
          "default": "unvalidated",
          "enum": [
            "unvalidated",
            "valid",
            "invalid",
            "review_required"
          ],
          "title": "Validationstatus",
          "type": "string"
        }
      },
      "required": [
        "claimId",
        "text",
        "citationIds"
      ],
      "title": "DocumentaryClaim",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "hypothesisId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Hypothesisid",
          "type": "string"
        },
        "scenarioIds": {
          "items": {
            "type": "string"
          },
          "title": "Scenarioids",
          "type": "array"
        },
        "supportingCitationIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Supportingcitationids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "hypothesisId",
        "text",
        "assumptions"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "NumericalFinding": {
      "additionalProperties": false,
      "properties": {
        "calculationIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Calculationids",
          "type": "array"
        },
        "findingId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Findingid",
          "type": "string"
        },
        "inputSnapshotIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Inputsnapshotids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "validationStatus": {
          "default": "unvalidated",
          "enum": [
            "unvalidated",
            "valid",
            "invalid"
          ],
          "title": "Validationstatus",
          "type": "string"
        }
      },
      "required": [
        "findingId",
        "text",
        "calculationIds"
      ],
      "title": "NumericalFinding",
      "type": "object"
    },
    "PolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "checkId": {
          "title": "Checkid",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "observed": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "checkId",
        "unit",
        "passed"
      ],
      "title": "PolicyCheck",
      "type": "object"
    },
    "PolicyEvaluation": {
      "additionalProperties": false,
