          "title": "Status",
          "type": "string"
        },
        "toolName": {
          "title": "Toolname",
          "type": "string"
        },
        "traceId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
          "title": "Traceid",
          "type": "string"
        }
      },
      "required": [
        "traceId",
        "agentRole",
        "toolName",
        "request",
        "responseSummary",
        "startedAt",
        "durationMs",
        "status"
      ],
      "title": "ToolTrace",
      "type": "object"
    },
    "UsageSummary": {
