    "RetrievalMode": {
      "enum": [
        "none",
        "hybrid_rag_v1",
        "graph_rag_v1"
      ],
      "title": "RetrievalMode",
      "type": "string"
    },
    "Side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "SizedOrder": {
      "additionalProperties": false,
      "properties": {
        "estimatedConsiderationUsd": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Estimatedconsiderationusd",
          "type": "string"
        },
        "estimatedDirtyPricePer100": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Estimateddirtypriceper100",
          "type": "string"
        },
        "face": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Face",
          "type": "string"
        },
        "securityId": {
          "pattern": "^[A-Z0-9][A-Z0-9\\-\\.]{1,63}$",
          "title": "Securityid",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "securityId",
        "side",
        "face",
        "estimatedDirtyPricePer100",
        "estimatedConsiderationUsd"
      ],
      "title": "SizedOrder",
      "type": "object"
    },
    "SpecialistTask": {
