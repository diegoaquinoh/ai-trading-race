        },
        "postTradeNavUsd": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posttradenavusd"
        },
        "postTradeParallelDv01Usd": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posttradeparalleldv01Usd"
        },
        "preTradeCashRatio": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pretradecashratio"
        },
        "preTradeMaxSecurityRatio": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pretrademaxsecurityratio"
        },
        "preTradeNavUsd": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pretradenavusd"
        },
        "preTradeParallelDv01Usd": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pretradeparalleldv01Usd"
        },
        "rejectedReasons": {
          "items": {
            "type": "string"
          },
          "title": "Rejectedreasons",
          "type": "array"
        },
        "sizedOrders": {
          "items": {
            "$ref": "#/$defs/SizedOrder"
          },
          "title": "Sizedorders",
          "type": "array"
        },
        "turnoverRatio": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnoverratio"
        }
      },
      "required": [
        "policyId",
        "decisionId",
        "action",
        "passed"
      ],
      "title": "PolicyEvaluation",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "supportingCalculationIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Supportingcalculationids",
          "type": "array"
        },
        "supportingClaimIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
            "type": "string"
          },
          "title": "Supportingclaimids",
          "type": "array"
        },
        "targetWeights": {
          "items": {
            "$ref": "#/$defs/TargetWeight"
          },
          "title": "Targetweights",
          "type": "array"
        }
      },
      "required": [
        "action"
