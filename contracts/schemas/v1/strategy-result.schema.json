      },
      "required": [
        "securityId",
        "weight"
      ],
      "title": "TargetWeight",
      "type": "object"
    },
    "ToolTrace": {
      "additionalProperties": false,
      "properties": {
        "agentRole": {
          "title": "Agentrole",
          "type": "string"
        },
        "durationMs": {
          "title": "Durationms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "outputRef": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-\\.:]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputref"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "responseSummary": {
          "additionalProperties": true,
          "title": "Responsesummary",
          "type": "object"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "denied_budget",
            "denied_policy"
